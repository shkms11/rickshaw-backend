DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rickshaw_db?schema=public"
# Optional: set this to Neon's direct (unpooled) connection string for migrations.
# If omitted, Prisma uses DATABASE_URL for migrations too.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-example.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-a-unique-random-secret"
PORT=5000
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://rickshaw-frontend-gjo4b2nhx-shkms11.vercel.app"
FRONTEND_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:5000"
# Payment setup is optional; the dashboard, GPS, and plan details work without it.
# Sandbox defaults to SSLCommerz's public test store. Set merchant credentials for live payments.
SSLCOMMERZ_IS_LIVE="false"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# Optional: without a Groq key the role-scoped built-in assistant still works.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"