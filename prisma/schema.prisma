generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums keep role, approval, availability, and payment states consistent across API and DB.
enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  DRIVER
}

enum AnnouncementAudience {
  SUPER_ADMIN
  ADMIN
  OWNER
  DRIVER
}

enum AiActionType {
  ANNOUNCEMENT_CREATE
  ANNOUNCEMENT_UPDATE
  RICKSHAW_STATUS
  DRIVER_STATUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverStatus {
  ONLINE
  OFFLINE
  ON_TRIP
}

enum RickshawStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

enum LocationSource {
  LIVE
  LAST_KNOWN
  DEMO
}

enum FleetActionType {
  LOST_RICKSHAW
  REMOVE_RICKSHAW
}

enum FleetActionStatus {
  OPEN
  APPROVED
  REJECTED
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String
  role      Role     @default(DRIVER)
  approvalStatus ApprovalStatus @default(PENDING)
  isRestricted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver?
  owner  Owner?
  profile UserProfile?
  adminAssignments AdminAssignment[] @relation("AdminAccount")
  issuedAdminAssignments AdminAssignment[] @relation("AdminIssuer")
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  targetedAnnouncements Announcement[] @relation("AnnouncementRecipient")
  aiActions AiActionLog[]
  updatedAdminNoticeBoards AdminNoticeBoard[] @relation("AdminNoticeBoardUpdater")

  // Named relations distinguish this user's passenger trips from trips they drive.
  passengerTrips Trip[] @relation("PassengerTrips")
  driverTrips    Trip[] @relation("DriverTrips")
  driverActivityEntries DriverActivityEntry[]

  payments   Payment[]
  complaints Complaint[]
  createdFleetActions FleetAction[] @relation("FleetActionCreator")
  reviewedFleetActions FleetAction[] @relation("FleetActionReviewer")

  @@index([role])
  @@index([name])
  @@index([createdAt])
}

model Driver {
  id        String       @id @default(cuid())
  userId    String       @unique
  licenseNo String?      @unique
  status    DriverStatus @default(OFFLINE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rickshaw Rickshaw?
  location  DriverLocation?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Owner {
  id     String @id @default(cuid())
  userId String @unique
  rickshawSequence Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rickshaws Rickshaw[]
  rentalIncomeEntries OwnerRentalIncomeEntry[]
  subscription OwnerSubscription?
  subscriptionPayments OwnerSubscriptionPayment[]
  adminAssignments AdminAssignment[]
  announcements Announcement[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  nid         String?
  nidIv       String?
  nidAuthTag  String?
  photoUrl    String?
  dateOfBirth DateTime?
  division    String?
  district    String?
  upazila     String?
  unionWard   String?
  villageRoad String?
  postalCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([division, district, upazila])
}

model AdminAssignment {
  id          String   @id @default(cuid())
  adminId     String
  ownerId     String?
  createdById String?
  isObserver  Boolean  @default(false)
  createdAt   DateTime @default(now())

  admin     User  @relation("AdminAccount", fields: [adminId], references: [id], onDelete: Cascade)
  owner     Owner? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AdminIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([adminId, ownerId])
  @@index([adminId])
  @@index([ownerId])
}

model Announcement {
  id              String               @id @default(cuid())
  title           String               @db.VarChar(120)
  message         String               @db.VarChar(2000)
  audience        AnnouncementAudience
  targetUserId    String?
  ownerId         String?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  targetUser User?  @relation("AnnouncementRecipient", fields: [targetUserId], references: [id], onDelete: Cascade)
  owner      Owner? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([audience, createdAt])
  @@index([targetUserId, createdAt])
  @@index([ownerId, audience, createdAt])
}

model AdminNoticeBoard {
  id          String   @id @default("admin")
  items       Json     @default("[]")
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("AdminNoticeBoardUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AiActionLog {
  id         String       @id @default(cuid())
  proposalId String       @unique
  userId     String
  type       AiActionType
  targetId   String
  beforeData Json?
  afterData  Json
  createdAt  DateTime     @default(now())
  undoneAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OwnerSubscription {
  // Subscription access is separate from trip-fare payments below.
  id              String   @id @default(cuid())
  ownerId         String   @unique
  trialStartedAt  DateTime @default(now())
  paidUntil       DateTime?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner    Owner                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([paidUntil])
}

model OwnerSubscriptionPayment {
  id             String        @id @default(cuid())
  ownerId        String
  transactionId  String        @unique
  gatewaySessionId String?
  validationId   String?
  amount         Decimal       @db.Decimal(10, 2)
  rickshawCount  Int
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  paidAt         DateTime?

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([createdAt])
}

model DriverLocation {
  // One latest point per driver; stopping GPS changes LIVE to LAST_KNOWN rather than deleting it.
  id        String   @id @default(cuid())
  driverId  String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  source    LocationSource @default(LIVE)
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Rickshaw {
  id      String         @id @default(cuid())
  plateNo String         @unique
  model   String?
  status  RickshawStatus @default(ACTIVE)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  driverId String? @unique
  driver   Driver? @relation(fields: [driverId], references: [id])

  trips Trip[]
  rentalIncomeEntries OwnerRentalIncomeEntry[]
  fleetActions FleetAction[]

  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model FleetAction {
  // The named user relations preserve both the reporter and the admin reviewer.
  id          String            @id @default(cuid())
  rickshawId  String
  createdById String
  reviewedById String?
  type        FleetActionType
  status      FleetActionStatus @default(OPEN)
  message     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  rickshaw  Rickshaw @relation(fields: [rickshawId], references: [id], onDelete: Cascade)
  createdBy User     @relation("FleetActionCreator", fields: [createdById], references: [id])
  reviewedBy User?   @relation("FleetActionReviewer", fields: [reviewedById], references: [id])

  @@index([rickshawId, status])
  @@index([type, status])
  @@index([createdAt])
}

model Trip {
  // Driver IDs here reference User IDs, unlike Rickshaw.driverId which references Driver.id.
  id String @id @default(cuid())

  passengerId String
  driverId    String?
  rickshawId  String?

  pickupLocation  String
  dropoffLocation String

  fare   Decimal    @db.Decimal(10, 2)
  status TripStatus @default(REQUESTED)

  passenger User      @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver    User?     @relation("DriverTrips", fields: [driverId], references: [id])
  rickshaw  Rickshaw? @relation(fields: [rickshawId], references: [id])

  payment    Payment?
  complaints Complaint[]

  createdAt DateTime @default(now())

  @@index([passengerId])
  @@index([driverId])
  @@index([rickshawId])
  @@index([status])
  @@index([pickupLocation])
  @@index([dropoffLocation])
  @@index([createdAt])
}

model DriverActivityEntry {
  id         String   @id @default(cuid())
  driverId   String
  workDate   DateTime @db.Date
  fare       Decimal  @db.Decimal(10, 2)
  distanceKm Float
  createdAt  DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, workDate])
}

model OwnerRentalIncomeEntry {
  id        String   @id @default(cuid())
  ownerId   String
  rickshawId String
  workDate  DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  owner    Owner   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rickshaw Rickshaw @relation(fields: [rickshawId], references: [id], onDelete: Cascade)

  @@unique([rickshawId, workDate])
  @@index([ownerId, workDate])
}

model Payment {
  // This is a trip fare (one payment per trip), not an owner plan payment.
  id String @id @default(cuid())

  tripId String @unique
  userId String

  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

model Complaint {
  id String @id @default(cuid())

  userId String
  tripId String?

  subject     String
  description String
  status      ComplaintStatus @default(OPEN)

  user User  @relation(fields: [userId], references: [id])
  trip Trip? @relation(fields: [tripId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tripId])
  @@index([status])
  @@index([subject])
  @@index([createdAt])
}
